<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/calc_background"
    android:padding="20dp"
    tools:context=".MainActivity">

    <LinearLayout
        android:id="@+id/display_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_display_panel"
        android:orientation="vertical"
        android:padding="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/text_expression"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="start"
            android:gravity="end"
            android:maxLines="1"
            android:text="(9 + 5) * 3"
            android:textColor="@color/calc_text_secondary"
            android:textSize="18sp"/>

        <TextView
            android:id="@+id/text_result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:text="42"
            android:textColor="@color/calc_text_primary"
            android:textSize="40sp"
            android:textStyle="bold"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/mode_row"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/display_container">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Scientific"
            android:textColor="@color/calc_text_secondary"
            android:textSize="14sp"
            android:textStyle="bold"/>
        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1"/>
        <Button
            android:id="@+id/button_toggle_scientific"
            style="@style/Widget.AppCalculator.Button.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="Hide"
            android:textAllCaps="false"/>
    </LinearLayout>

    <HorizontalScrollView
        android:id="@+id/scientific_scroll"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fillViewport="true"
        android:scrollbars="none"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/mode_row">

        <LinearLayout
            android:id="@+id/scientific_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/button_sin"
                style="@style/Widget.AppCalculator.Button.Secondary"
                android:layout_width="72dp"
                android:layout_height="56dp"
                android:layout_marginEnd="8dp"
                android:text="sin"/>

            <Button
                android:id="@+id/button_cos"
                style="@style/Widget.AppCalculator.Button.Secondary"
                android:layout_width="72dp"
                android:layout_height="56dp"
                android:layout_marginEnd="8dp"
                android:text="cos"/>

            <Button
                android:id="@+id/button_tan"
                style="@style/Widget.AppCalculator.Button.Secondary"
                android:layout_width="72dp"
                android:layout_height="56dp"
                android:layout_marginEnd="8dp"
                android:text="tan"/>

            <Button
                android:id="@+id/button_ln"
                style="@style/Widget.AppCalculator.Button.Secondary"
                android:layout_width="72dp"
                android:layout_height="56dp"
                android:layout_marginEnd="8dp"
                android:text="ln"/>

            <Button
                android:id="@+id/button_log"
                style="@style/Widget.AppCalculator.Button.Secondary"
                android:layout_width="72dp"
                android:layout_height="56dp"
                android:layout_marginEnd="8dp"
                android:text="log"/>

            <Button
                android:id="@+id/button_sqrt"
                style="@style/Widget.AppCalculator.Button.Secondary"
                android:layout_width="72dp"
                android:layout_height="56dp"
                android:layout_marginEnd="8dp"
                android:text="√"/>

            <Button
                android:id="@+id/button_pi"
                style="@style/Widget.AppCalculator.Button.Secondary"
                android:layout_width="72dp"
                android:layout_height="56dp"
                android:layout_marginEnd="8dp"
                android:text="π" />

            <Button
                android:id="@+id/button_power"
                style="@style/Widget.AppCalculator.Button.Secondary"
                android:layout_width="72dp"
                android:layout_height="56dp"
                android:text="xʸ" />
        </LinearLayout>
    </HorizontalScrollView>

    <androidx.gridlayout.widget.GridLayout
        android:id="@+id/basic_keypad"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        app:alignmentMode="alignMargins"
        app:columnCount="4"
        app:rowCount="5"
        app:useDefaultMargins="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/scientific_scroll">

    <Button
        android:id="@+id/button_ac"
        style="@style/Widget.AppCalculator.Button.Secondary"
        android:layout_width="0dp"
        android:layout_height="64dp"
        app:layout_columnWeight="1"
        android:text="AC" />

    <Button
        android:id="@+id/button_plus_minus"
        style="@style/Widget.AppCalculator.Button.Secondary"
        android:layout_width="0dp"
        android:layout_height="64dp"
        app:layout_columnWeight="1"
        android:text="±" />

    <Button
        android:id="@+id/button_percent"
        style="@style/Widget.AppCalculator.Button.Secondary"
        android:layout_width="0dp"
        android:layout_height="64dp"
        app:layout_columnWeight="1"
        android:text="%" />

    <Button
        android:id="@+id/button_divide"
        style="@style/Widget.AppCalculator.Button.Operator"
        android:layout_width="0dp"
        android:layout_height="64dp"
        app:layout_columnWeight="1"
        android:text="÷" />

    <Button
        android:id="@+id/button_7"
        style="@style/Widget.AppCalculator.Button"
        android:layout_width="0dp"
        android:layout_height="64dp"
        app:layout_columnWeight="1"
        android:text="7" />

    <Button
        android:id="@+id/button_8"
        style="@style/Widget.AppCalculator.Button"
        android:layout_width="0dp"
        android:layout_height="64dp"
        app:layout_columnWeight="1"
        android:text="8" />

    <Button
        android:id="@+id/button_9"
        style="@style/Widget.AppCalculator.Button"
        android:layout_width="0dp"
        android:layout_height="64dp"
        app:layout_columnWeight="1"
        android:text="9" />

    <Button
        android:id="@+id/button_multiply"
        style="@style/Widget.AppCalculator.Button.Operator"
        android:layout_width="0dp"
        android:layout_height="64dp"
        app:layout_columnWeight="1"
        android:text="×" />

    <Button
        android:id="@+id/button_4"
        style="@style/Widget.AppCalculator.Button"
        android:layout_width="0dp"
        android:layout_height="64dp"
        app:layout_columnWeight="1"
        android:text="4" />

    <Button
        android:id="@+id/button_5"
        style="@style/Widget.AppCalculator.Button"
        android:layout_width="0dp"
        android:layout_height="64dp"
        app:layout_columnWeight="1"
        android:text="5" />

    <Button
        android:id="@+id/button_6"
        style="@style/Widget.AppCalculator.Button"
        android:layout_width="0dp"
        android:layout_height="64dp"
        app:layout_columnWeight="1"
        android:text="6" />

    <Button
        android:id="@+id/button_minus"
        style="@style/Widget.AppCalculator.Button.Operator"
        android:layout_width="0dp"
        android:layout_height="64dp"
        app:layout_columnWeight="1"
        android:text="−" />

    <Button
        android:id="@+id/button_1"
        style="@style/Widget.AppCalculator.Button"
        android:layout_width="0dp"
        android:layout_height="64dp"
        app:layout_columnWeight="1"
        android:text="1" />

    <Button
        android:id="@+id/button_2"
        style="@style/Widget.AppCalculator.Button"
        android:layout_width="0dp"
        android:layout_height="64dp"
        app:layout_columnWeight="1"
        android:text="2" />

    <Button
        android:id="@+id/button_3"
        style="@style/Widget.AppCalculator.Button"
        android:layout_width="0dp"
        android:layout_height="64dp"
        app:layout_columnWeight="1"
        android:text="3" />

    <Button
        android:id="@+id/button_plus"
        style="@style/Widget.AppCalculator.Button.Operator"
        android:layout_width="0dp"
        android:layout_height="64dp"
        app:layout_columnWeight="1"
        android:text="+" />

    <Button
        android:id="@+id/button_0"
        style="@style/Widget.AppCalculator.Button"
        android:layout_width="0dp"
        android:layout_height="64dp"
        app:layout_columnWeight="1"
        app:layout_columnSpan="2"
        android:text="0" />

    <Button
        android:id="@+id/button_decimal"
        style="@style/Widget.AppCalculator.Button"
        android:layout_width="0dp"
        android:layout_height="64dp"
        app:layout_columnWeight="1"
        android:text="." />

        <Button
            android:id="@+id/button_equals"
            style="@style/Widget.AppCalculator.Button.Accent"
            android:layout_width="0dp"
            android:layout_height="64dp"
            app:layout_columnWeight="1"
            android:text="=" />
    </androidx.gridlayout.widget.GridLayout>

</androidx.constraintlayout.widget.ConstraintLayout>